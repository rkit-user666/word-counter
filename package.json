{
  "name": "word-counter",
  "displayName": "ITMO Word Counter",
  "description": "Laboratory Work No.3 for ITMO University",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "word-counter.countStats",
        "title": "Count Words & Characters (Lab 3)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "word-counter.countStats",
          "group": "navigation"
        }
      ]
    }
  }
}